PEPPER_TG_TOKEN=
PEPPER_TG_CHAT=
# Telegram numeric user ID(s), comma separated. Find with /whoami after /start.
PEPPER_TG_ADMIN_IDS=
# auto = publish immediately; review = send previews to PEPPER_TG_ADMIN and wait for decision
PEPPER_PUBLISH_MODE=auto
PEPPER_TG_ADMIN=
PEPPER_INTERVAL=180
PEPPER_MAX_PER_CYCLE=5
PEPPER_SEED_FIRST=true
PEPPER_REQUEST_DELAY=2.0
# 2captcha API key for bypassing Yandex SmartCaptcha (get at https://2captcha.com)
PEPPER_2CAPTCHA_KEY=
PEPPER_PROXY=
# Proxy for Telegram API, e.g. http://user:pass@host:port
PEPPER_TG_PROXY=
